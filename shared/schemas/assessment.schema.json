{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Assessment",
  "description": "형성평가 결과 스키마 (B2 태스크)",
  "type": "object",
  "required": ["session_id", "student_id", "student_name", "chapter_id", "submitted_at", "correct_count", "total_count", "score", "weak_concepts"],
  "additionalProperties": false,
  "properties": {
    "session_id": { "type": "string" },
    "student_id": { "type": "string", "maxLength": 30 },
    "student_name": { "type": "string", "maxLength": 50 },
    "chapter_id": { "type": "string", "maxLength": 4 },
    "chapter_title": { "type": "string", "maxLength": 100 },
    "submitted_at": { "type": "string", "format": "date-time" },
    "correct_count": { "type": "integer", "minimum": 0 },
    "total_count": { "type": "integer", "minimum": 1 },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "weak_concepts": {
      "type": "array",
      "items": { "type": "string", "maxLength": 100 },
      "maxItems": 20
    },
    "bloom_breakdown": {
      "type": "object",
      "description": "Bloom 레벨별 정답/총문항 집계",
      "additionalProperties": {
        "type": "object",
        "required": ["correct", "total"],
        "properties": {
          "correct": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "messages": {
      "type": "array",
      "description": "대화 로그 (system 메시지 제외)",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    }
  }
}
