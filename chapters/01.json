    "DAC",
    "\uD558\uC774 \uC784\uD53C\uB358\uC2A4"
  ],
  "sections": [
    {
      "id": "1-1",
      "title": "1.1 \uB514\uC9C0\uD138\uACFC \uC544\uB0A0\uB85C\uADF8",
      "simulation": "analogDigital",
      "content": [
        {
          "type": "text",
          "body": "\uB17C\uB9AC\uD68C\uB85C\uB780 0\uACFC 1\uC758 \uC774\uC9C4 \uC2E0\uD638\uB97C \uC785\uB825\uBC1B\uC544, \uB17C\uB9AC \uADDC\uCE59\uC5D0 \uB530\uB77C \uCD9C\uB825\uC73C\uB85C \uBCC0\uD658\uD558\uB294 \uB514\uC9C0\uD138 \uC804\uC790 \uD68C\uB85C\uC785\uB2C8\uB2E4. \uC774\uC9C4 \uC2E0\uD638 \u2192 \uBD88 \uB300\uC218 \u2192 \uB17C\uB9AC\uAC8C\uC774\uD2B8 \u2192 \uB17C\uB9AC\uD68C\uB85C \u2192 \uCEF4\uD4E8\uD130 \uC2DC\uC2A4\uD15C\uC73C\uB85C \uC774\uC5B4\uC9C0\uB294 \uD750\uB984\uC774 \uD604\uB300 \uCEF4\uD4E8\uD305\uC758 \uAE30\uBC18\uC785\uB2C8\uB2E4."
        },
        {
          "type": "comparison",
          "title": "\uC544\uB0A0\uB85C\uADF8 \uC2E0\uD638 vs \uB514\uC9C0\uD138 \uC2E0\uD638",
          "left": {
            "label": "\uC544\uB0A0\uB85C\uADF8 \uC2E0\uD638 (Analog Signal)",
            "body": "\uC790\uC5F0\uACC4\uC5D0\uC11C \uC77C\uC5B4\uB098\uB294 \uBB3C\uB9AC\uC801\uC778 \uC591\uC740 \uC2DC\uAC04\uC5D0 \uB530\uB77C \uC5F0\uC18D\uC801\uC73C\uB85C \uBCC0\uD654\uD569\uB2C8\uB2E4. \uC628\uB3C4, \uC2B5\uB3C4, \uC18C\uB9AC, \uBE5B \uB4F1\uC740 \uC2DC\uAC04\uC5D0 \uB530\uB77C \uC5F0\uC18D\uC801\uC778 \uAC12\uC744 \uAC16\uC2B5\uB2C8\uB2E4.",
            "color": "blue"
          },
          "right": {
            "label": "\uB514\uC9C0\uD138 \uC2E0\uD638 (Digital Signal)",
            "body": "\uBD84\uBA85\uD788 \uAD6C\uBCC4\uB418\uB294 \uB450 \uB808\uBCA8(0\uACFC 1)\uC758 \uC2E0\uD638\uAC12\uB9CC\uC744 \uAC16\uC2B5\uB2C8\uB2E4. \uC774\uC0B0\uC801(discrete)\uC73C\uB85C \uD45C\uD604\uB418\uBA70 \uC7A1\uC74C\uC5D0 \uAC15\uD569\uB2C8\uB2E4.",
            "color": "green"
          }
        },
        {
          "type": "comparison",
          "title": "\uB514\uC9C0\uD138 \uC2DC\uC2A4\uD15C vs \uC544\uB0A0\uB85C\uADF8 \uC2DC\uC2A4\uD15C",
          "left": {
            "label": "\uB514\uC9C0\uD138 \uC2DC\uC2A4\uD15C",
            "body": "\uC774\uC0B0\uC801\uC778 \uC815\uBCF4\uB97C \uAC00\uACF5\uD558\uACE0 \uCC98\uB9AC\uD574\uC11C \uCD5C\uC885 \uBAA9\uC801\uC73C\uB85C \uD558\uB294 \uC815\uBCF4\uB97C \uCD9C\uB825\uD558\uB294 \uBAA8\uB4E0 \uD615\uD0DC\uC758 \uC7A5\uCE58",
            "color": "green"
          },
          "right": {
            "label": "\uC544\uB0A0\uB85C\uADF8 \uC2DC\uC2A4\uD15C",
            "body": "\uC5F0\uC18D\uC801\uC778 \uC815\uBCF4\uB97C \uC785\uB825\uBC1B\uC544 \uCC98\uB9AC\uD574\uC11C \uC5F0\uC18D\uC801\uC778 \uD615\uD0DC\uC758 \uC815\uBCF4\uB97C \uCD9C\uB825\uD558\uB294 \uC2DC\uC2A4\uD15C",
            "color": "blue"
          }
        },
        {
          "type": "list",
          "title": "\uB514\uC9C0\uD138 \uC2DC\uC2A4\uD15C\uC758 \uC7A5\uC810",
          "style": "check",
          "items": [
            "\uB0B4\u00B7\uC678\uBD80 \uC7A1\uC74C\uC5D0 \uAC15\uD558\uB2E4 (0\uACFC 1\uB9CC \uAD6C\uBCC4\uD558\uBA74 \uB418\uBBC0\uB85C)",
            "\uC124\uACC4\uAC00 \uC6A9\uC774\uD558\uB2E4",
            "\uD504\uB85C\uADF8\uB798\uBC0D\uC73C\uB85C \uC804\uCCB4 \uC2DC\uC2A4\uD15C\uC744 \uC81C\uC5B4\uD558\uC5EC \uC0AC\uC591 \uBCC0\uACBD\uC5D0 \uC27D\uAC8C \uB300\uC751",
            "\uC815\uBCF4\uB97C \uC800\uC7A5\uD558\uAC70\uB098 \uAC00\uACF5\uD558\uAE30\uAC00 \uC6A9\uC774\uD558\uB2E4",
            "\uC815\uBCF4\uCC98\uB9AC\uC758 \uC815\uD655\uC131\uACFC \uC815\uBC00\uB3C4\uB97C \uB192\uC77C \uC218 \uC788\uB2E4",
            "\uC804\uCCB4 \uC2DC\uC2A4\uD15C\uC744 \uC18C\uD615\uD654, \uC800\uAC00\uACA9\uD654\uB85C \uAD6C\uC131\uD560 \uC218 \uC788\uB2E4"
          ]
        },
        {
          "type": "list",
          "title": "\uB514\uC9C0\uD138 \uC2DC\uC2A4\uD15C\uC758 \uB2E8\uC810",
          "style": "warning",
          "items": [
            "A/D \uBCC0\uD658\uAE30\uC640 D/A \uBCC0\uD658\uAE30\uAC00 \uD544\uC694\uD558\uB2E4",
            "\uB514\uC9C0\uD138 \uC2E0\uD638\uB97C \uC544\uB0A0\uB85C\uADF8\uB85C \uBCC0\uD658 \uC2DC \uC0D8\uD50C\uB9C1 \uB370\uC774\uD130\uAC00 \uBD80\uC871\uD558\uBA74 \uC624\uCC28 \uBC1C\uC0DD"
          ]
        },
        {
          "type": "simulation",
          "simId": "analogDigital",
          "title": "\uC544\uB0A0\uB85C\uADF8 vs \uB514\uC9C0\uD138 \uD30C\uD615 \uBE44\uAD50"
        },
        {
          "type": "definition",
          "term": "\uB178\uC774\uC988 \uB9C8\uC9C4 (Noise Margin) / \uC784\uACC4\uAC12 (Threshold)",
          "body": "\uB514\uC9C0\uD138 \uD68C\uB85C\uB294 \uC785\uB825 \uC804\uC555\uC744 \uC5F0\uC18D\uAC12\uC73C\uB85C \uD574\uC11D\uD558\uC9C0 \uC54A\uACE0, \uC784\uACC4\uAC12\uC744 \uAE30\uC900\uC73C\uB85C 0 \uB610\uB294 1\uB85C \uD310\uC815\uD569\uB2C8\uB2E4. \uC784\uACC4\uAC12 \uC8FC\uBCC0\uC744 \uC81C\uC678\uD55C \uAD6C\uAC04(\uB178\uC774\uC988 \uB9C8\uC9C4)\uC5D0\uC11C\uB294 \uC7A1\uC74C\uC774 \uC11E\uC5EC\uB3C4 \uD310\uC815 \uACB0\uACFC\uAC00 \uC720\uC9C0\uB418\uBBC0\uB85C \uC2E0\uB8B0\uC131\uC774 \uB192\uC2B5\uB2C8\uB2E4.\n\n\uC608: \uAE30\uC900 \uC804\uC555\uC774 2.5V\uC77C \uB54C 0\uC73C\uB85C \uD310\uC815\uB418\uB294 \uAD6C\uAC04\uACFC 1\uB85C \uD310\uC815\uB418\uB294 \uAD6C\uAC04 \uC0AC\uC774 \uC5EC\uC720\uAC00 \uD074\uC218\uB85D \uC7A1\uC74C\uC5D0 \uAC15\uD569\uB2C8\uB2E4."
        },
        {
          "type": "example",
          "title": "\uB178\uC774\uC988 \uB9C8\uC9C4 \uC9C1\uAD00 \uC608\uC2DC",
          "problem": "\uC785\uB825 \uC2E0\uD638\uAC00 4.9V\uC778\uB370 \uC7A1\uC74C\uC73C\uB85C \u00B10.2V \uD754\uB4E4\uB9B0\uB2E4\uBA74, \uC65C \uB514\uC9C0\uD138 \uD68C\uB85C\uB294 \uB300\uBD80\uBD84 \uAC19\uC740 \uAC12\uC73C\uB85C \uC778\uC2DD\uD560\uAE4C\uC694?",
          "solution": "\uB514\uC9C0\uD138 \uD68C\uB85C\uB294 \uC5F0\uC18D \uC804\uC555 \uC790\uCCB4\uAC00 \uC544\uB2C8\uB77C \uC784\uACC4\uAC12 \uAE30\uC900\uC73C\uB85C High/Low\uB97C \uD310\uB2E8\uD569\uB2C8\uB2E4. 4.9V \u00B1 0.2V\uB294 \uBCF4\uD1B5 High \uD310\uC815 \uAD6C\uAC04 \uB0B4\uBD80\uC5D0 \uC788\uC73C\uBBC0\uB85C \uC7A1\uC74C\uC774 \uC788\uC5B4\uB3C4 \uAC19\uC740 \uB17C\uB9AC\uAC12(1)\uB85C \uD574\uC11D\uB429\uB2C8\uB2E4. \uC989, \uC784\uACC4\uAC12\uACFC\uC758 \uC5EC\uC720(\uB178\uC774\uC988 \uB9C8\uC9C4)\uAC00 \uC548\uC815\uC131\uC744 \uB9CC\uB4ED\uB2C8\uB2E4."
        }
      ]
    },
    {
      "id": "1-2",
      "title": "1.2 \uB514\uC9C0\uD138 \uC815\uBCF4\uC758 \uD45C\uD604",
      "simulation": "unitConverter",
      "content": [
        {
          "type": "definition",
          "term": "\uC774\uC9C4\uC218 \uCCB4\uACC4 (Binary System)",
          "body": "\uB514\uC9C0\uD138 \uC815\uBCF4\uB97C \uD45C\uD604\uD558\uAE30 \uC704\uD574 2\uC9C4\uC218 \uCCB4\uACC4\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \"0\"\uACFC \"1\"\uB9CC\uC758 2\uC885\uB958 \uB514\uC9C0\uD2B8(digit)\uB97C \uC0AC\uC6A9\uD558\uC5EC \uBAA8\uB4E0 \uC815\uBCF4\uB97C \uD45C\uD604\uD569\uB2C8\uB2E4."
        },
        {
          "type": "definition",
          "term": "\uD558\uC774 \uC784\uD53C\uB358\uC2A4 (High Impedance)",
          "body": "\uC804\uB958\uAC00 \uAC70\uC758 \uD750\uB974\uC9C0 \uC54A\uB294 \uC0C1\uD0DC\uB85C, \uB0B4\uBD80\uC801\uC73C\uB85C \uB9E4\uC6B0 \uD070 \uC800\uD56D\uCC98\uB7FC \uB3D9\uC791\uD569\uB2C8\uB2E4. \uC785\uB825\uC2E0\uD638\uC758 \uBC94\uC704\uAC00 \uB113\uC740 \uC774\uC720\uB294 \uC2E0\uD638 \uC804\uC1A1 \uACFC\uC815 \uC911 \uBC1C\uC0DD\uD558\uB294 \uB178\uC774\uC988\uC5D0 \uB300\uC751\uD558\uAE30 \uC704\uD568\uC785\uB2C8\uB2E4."
        },
        {
