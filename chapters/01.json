{
  "id": "01",
  "title": "\uC81C01\uC7A5. \uB4E4\uC5B4\uAC00\uAE30",
  "objectives": [
    "\uC544\uB0A0\uB85C\uADF8 \uC2E0\uD638\uC640 \uB514\uC9C0\uD138 \uC2E0\uD638\uC758 \uAC1C\uB150\uC744 \uC124\uBA85\uD560 \uC218 \uC788\uB2E4",
    "\uB514\uC9C0\uD138 \uC815\uBCF4\uC758 \uD45C\uD604\uBC29\uBC95\uC744 \uC124\uBA85\uD560 \uC218 \uC788\uB2E4",
    "\uC8FC\uAE30\uC801\uC778 \uD30C\uD615\uC5D0\uC11C \uC8FC\uD30C\uC218, \uC8FC\uAE30, \uB4C0\uD2F0 \uC0AC\uC774\uD074\uC744 \uC124\uBA85\uD560 \uC218 \uC788\uB2E4",
    "\uB514\uC9C0\uD138 \uD68C\uB85C\uC758 \uC7A5\uC810\uACFC \uB2E8\uC810\uC5D0 \uB300\uD574 \uC124\uBA85\uD560 \uC218 \uC788\uB2E4",
    "ADC\uC640 DAC\uC758 \uAC1C\uB150\uC744 \uC124\uBA85\uD560 \uC218 \uC788\uB2E4"
  ],
  "keyConcepts": [
    "\uC544\uB0A0\uB85C\uADF8 \uC2E0\uD638",
    "\uB514\uC9C0\uD138 \uC2E0\uD638",
    "\uBE44\uD2B8",
    "\uBC14\uC774\uD2B8",
    "\uC8FC\uAE30",
    "\uC8FC\uD30C\uC218",
    "\uB4C0\uD2F0 \uC0AC\uC774\uD074",
